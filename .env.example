# ---------- Firebase (client) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------- Firebase Admin (server only) ----------
# From Firebase Console > Project settings > Service accounts > Generate new private key.
# Needed to verify ID tokens' signing context and to set the `role: authenticated` claim
# that Supabase requires for Firebase third-party auth.
# Keep the private key on one line with literal \n sequences.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------- Supabase (client-safe, protected by RLS) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------- NVIDIA NIM (server only) ----------
NVIDIA_NIM_API_KEY=
# Any chat model from https://build.nvidia.com, e.g. openai/gpt-oss-20b
NVIDIA_NIM_MODEL=openai/gpt-oss-20b
# Fallback used once if the primary yields no token (default nvidia/nemotron-3-super-120b-a12b)
NVIDIA_NIM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# NOTE: user-supplied provider keys (OpenAI/Anthropic/Gemini/...) are NOT configured here - they are sent per request and never stored.

# Supabase service role (server only - NEVER expose; used by /api/prompts after verifying the Firebase token)
SUPABASE_SERVICE_ROLE_KEY=
